NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<dbUser>:<dbPassword>@<your-cluster>.mongodb.net/bytebank?retryWrites=true&w=majority
JWT_SECRET=<generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))">
JWT_EXPIRES_IN=2h
COOKIE_NAME=bb_session
CLIENT_ORIGIN=http://localhost:5173
# Email is only used for the optional 'forgot password' link and 'payment received' notices.
# console = links/messages print in the server terminal (no setup needed).  smtp = real sending (fill SMTP_* below).
EMAIL_MODE=console
MAIL_FROM="Bytebank <no-reply@bytebank.dev>"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
LOGIN_RATE_MAX=5
INITIAL_BALANCE_PAISE=1000000
MAX_TRANSFER_PAISE=5000000
MAX_ADMIN_DEPOSIT_PAISE=10000000
ADMIN_SEED_EMAIL=admin@bytebank.dev
ADMIN_SEED_PASSWORD=ChangeMe12345
